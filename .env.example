# Server port
PORT=8080

# Optional: leave blank to run with the thread-safe in-memory 23-plant store locally.
# Set to PostgreSQL DSN in Docker/production for ACID persistence.
DATABASE_URL=

# Optional: set to require X-API-Key header on POST /adjust and POST /transfers
ERP_API_KEY=

# Comma-separated allowed CORS origins (defaults to * for local development)
CORS_ORIGINS=*